rules_version = '2';
// 仓库软件正式版安全规则（名单登录版）
// - 名单（roster）里有的名字：任何设备输入名字就能进，身份按名单
// - 名单里没有的名字：自动登记为领用人
// - 名单和身份只有管理员能改；没登录过的设备看不到任何仓库数据
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function memberPath(u) { return /databases/$(database)/documents/members/$(u); }
    function rosterPath(n) { return /databases/$(database)/documents/roster/$(n); }
    function bootPath() { return /databases/$(database)/documents/meta/boot; }
    function isMember() { return signed() && exists(memberPath(request.auth.uid)); }
    function isAdmin() { return isMember() && get(memberPath(request.auth.uid)).data.admin == true; }
    function okRole(r) { return r in ['keeper', 'user', 'buyer', 'leader', 'viewer']; }
    function firstOne() { return !exists(bootPath()) && getAfter(bootPath()).data.uid == request.auth.uid; }

    // 名单：名字 → 身份
    match /roster/{n} {
      allow get: if signed();
      allow list: if isMember();
      // 名单里没有的人第一次进：只能把自己登记成领用人（第一个人除外：管理员）
      allow create: if signed() && request.resource.data.keys().hasOnly(['role', 'admin', 't'])
        && n.size() > 0 && n.size() <= 20
        && getAfter(memberPath(request.auth.uid)).data.name == n
        && ((request.resource.data.role == 'user' && request.resource.data.admin == false) || firstOne());
      allow create, update, delete: if isAdmin() && (request.resource == null || okRole(request.resource.data.role));
    }

    // 这台设备是谁：身份必须和名单一致
    match /members/{u} {
      allow get: if signed() && (request.auth.uid == u || isMember());
      allow list: if isMember();
      allow create: if signed() && request.auth.uid == u
        && request.resource.data.keys().hasOnly(['name', 'role', 'admin', 't'])
        && request.resource.data.name is string
        && getAfter(rosterPath(request.resource.data.name)).data.role == request.resource.data.role
        && getAfter(rosterPath(request.resource.data.name)).data.admin == request.resource.data.admin;
      allow create, update: if isAdmin() && okRole(request.resource.data.role);
      allow delete: if isAdmin();
    }

    match /meta/boot {
      allow get: if signed();
      allow create: if signed() && request.resource.data.keys().hasOnly(['uid', 't'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(memberPath(request.auth.uid)).data.admin == true;
    }
    match /meta/{id} {
      allow read: if isMember();
      allow write: if isMember() && id != 'boot';
    }

    // 旧版留下的集合：只读
    match /names/{n} { allow read: if isMember(); allow write: if isAdmin(); }
    match /devreqs/{u} { allow read, write: if isAdmin(); }

    // 仓库数据：登录过的人才能读写
    match /items/{id} { allow read, write: if isMember(); }
    match /records/{id} { allow read, write: if isMember(); }
    match /lends/{id} { allow read, write: if isMember(); }
    match /requests/{id} { allow read, write: if isMember(); }
    match /audit/{id} { allow read, write: if isMember(); }
    match /photos/{id} { allow read, write: if isMember(); }
  }
}
